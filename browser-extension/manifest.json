{
  "manifest_version": 3,
  "name": "Job Scam Detector",
  "version": "1.0",
  "description": "Detects potential job scams on websites",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Scam Detector"
  }
}